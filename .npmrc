# Supply-chain hardening — see docs/supply-chain.md for the full policy.
#
# No dependency install scripts, ever. Every dep that declares a hook works
# without it: koffi ships prebuilt binaries for all platforms inside the
# package (its install script is only a build-from-source fallback), esbuild's
# binary arrives via an optional platform dep (postinstall is a fallback
# check), protobufjs's postinstall is a version warning. `prepare` scripts
# never run for registry installs. CI already publishes from an
# --ignore-scripts install and the bundle smoke tests boot the result.
# privateer-agent itself has no install scripts by design — patches apply at
# LAUNCH (bin/apply-patches.mjs), never at install.
ignore-scripts=true

# New deps land exactly pinned; upgrades are deliberate lockfile diffs
# (Dependabot with a cooldown), not silent semver drift.
save-exact=true

fund=false

# The pi ecosystem's community extensions (pi-mcp-adapter, pi-background-tasks)
# publish on their own cadence and their peerDependencies on
# @earendil-works/pi-coding-agent lag a few days behind each pi core release —
# e.g. pi-background-tasks 2.5.0's peer range tops out at ^0.84.0 even though it
# runs fine against 0.86.0 (verified: the full test suite, including the MCP and
# background-task suites, is green). Without this, `npm ci` hard-fails with
# ERESOLVE the moment pi core is bumped ahead of what those packages have
# declared, even though nothing is actually broken. Reassess when they publish a
# release with a peer range that includes the pinned pi-coding-agent version.
legacy-peer-deps=true
