+// Privateer: a background shell must see the machine's PATH, not Privateer's private Node.
+function withoutPrivateRuntime(env: NodeJS.ProcessEnv): NodeJS.ProcessEnv {
+  const hidden = env['PRIVATEER_PRIVATE_RUNTIME_DIR'];
+  if (!hidden) return env;
+  const key = Object.keys(env).find((name) => name.toLowerCase() === 'path') ?? 'PATH';
+  const visible = (env[key] ?? '').split(delimiter).filter((entry) => entry !== hidden);
+  return { ...env, [key]: visible.join(delimiter) };
+}
